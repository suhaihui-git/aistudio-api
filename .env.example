# aistudio-api 配置
# 复制此文件为 .env 并修改

# 服务端口
AISTUDIO_PORT=8090

# Camoufox 浏览器调试端口
AISTUDIO_CAMOUFOX_PORT=9222

# Camoufox 是否无头模式（1=无头，0=有头）
AISTUDIO_CAMOUFOX_HEADLESS=1

# Camoufox Python 路径（可选，留空使用系统默认）
AISTUDIO_CAMOUFOX_PYTHON=

# 管理后台密码（必须配置，访问网页后台需要登录）
AISTUDIO_ADMIN_PASSWORD=change-this-password

# 管理后台会话签名密钥（建议改成 32 字符以上随机字符串）
AISTUDIO_ADMIN_SESSION_SECRET=change-this-random-secret

# API Key 存储文件
AISTUDIO_API_KEYS_FILE=/app/data/api_keys.json

# 代理地址
AISTUDIO_PROXY=

# 认证文件路径（可选，留空自动搜索 data/ 目录）
AISTUDIO_AUTH_FILE=

# 临时文件目录
AISTUDIO_TMP_DIR=/tmp

# 超时设置（秒）
AISTUDIO_TIMEOUT_REPLAY=120
AISTUDIO_TIMEOUT_STREAM=120
AISTUDIO_TIMEOUT_CAPTURE=30

# 快照缓存
AISTUDIO_SNAPSHOT_CACHE_TTL=3600
AISTUDIO_SNAPSHOT_CACHE_MAX=100

# 调试：是否把上游原始响应和改写请求落盘
AISTUDIO_DUMP_RAW_RESPONSE=0
AISTUDIO_DUMP_RAW_RESPONSE_DIR=/tmp

# 默认文本模型
AISTUDIO_DEFAULT_TEXT_MODEL=gemma-4-31b-it

# 默认生图模型
AISTUDIO_DEFAULT_IMAGE_MODEL=gemini-3.1-flash-image-preview

# ========== 账号轮询配置 ==========

# 账号存储目录。账号会保存 auth.json 和持久浏览器 profile，服务器部署请挂载持久化目录。
AISTUDIO_ACCOUNTS_DIR=

# 轮询模式：round_robin（轮询）、lru（最近最少使用）、least_rl（最少限流）
AISTUDIO_ACCOUNT_ROTATION_MODE=round_robin

# 账号冷却时间（秒）
AISTUDIO_ACCOUNT_COOLDOWN_SECONDS=60

# 单账号最大重试次数
AISTUDIO_ACCOUNT_MAX_RETRIES=3

# 单账号最大并发数。默认 1；大于 1 时会启动多个独立浏览器 worker。
# 单账号建议先从 2 开始压测，过高可能触发 AI Studio 风控或占用大量内存。
AISTUDIO_SINGLE_ACCOUNT_MAX_CONCURRENCY=1

# 旧配置名，未设置 AISTUDIO_SINGLE_ACCOUNT_MAX_CONCURRENCY 时仍会作为兼容默认值。
AISTUDIO_MAX_CONCURRENCY=1

# 账号切换、导入、导出等独占操作等待请求结束的最长时间（秒）
AISTUDIO_ACCOUNT_OPERATION_TIMEOUT=30

# 登录用 Camoufox 端口
AISTUDIO_LOGIN_CAMOUFOX_PORT=9223

# 线上交互登录桌面。Docker 中设为 1 会启动 Xvfb + x11vnc + noVNC。
AISTUDIO_ENABLE_LOGIN_DESKTOP=1
AISTUDIO_LOGIN_NOVNC_PORT=6080
AISTUDIO_LOGIN_NOVNC_BIND=127.0.0.1:6080

# 管理后台点击“登录账号”后打开的远程浏览器地址。
# 留空会按当前访问后台的域名/IP 自动推导为 http(s)://同主机:6080/vnc.html。
AISTUDIO_LOGIN_NOVNC_URL=
AISTUDIO_LOGIN_NOVNC_PUBLIC_PORT=6080
AISTUDIO_LOGIN_NOVNC_SCHEME=
AISTUDIO_LOGIN_DESKTOP_GEOMETRY=1600x900x24
AISTUDIO_LOGIN_BROWSER_WIDTH=1440
AISTUDIO_LOGIN_BROWSER_HEIGHT=800

# 可选：VNC 密码。强烈建议不要把 6080 直接裸露公网，优先放到反代认证或内网/VPN。
AISTUDIO_LOGIN_VNC_PASSWORD=
